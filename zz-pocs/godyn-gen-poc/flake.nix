{
  description = "godyn-gen-poc: dagnabit facades and tommy-generate output produced in derivation space (nothing generated is committed)";

  inputs = {
    # This tree's igloo (relative path input: only git-tracked files are seen).
    igloo.url = "path:../..";
    # The generators. No `follows igloo`: each keeps its own locked igloo, so
    # their binaries are the ones their repos build (and cache).
    tommy.url = "https://code.linenisgreat.com/tommy/archive/master.tar.gz";
    purse-first.url = "https://code.linenisgreat.com/purse-first/archive/master.tar.gz";
  };

  outputs =
    {
      self,
      igloo,
      tommy,
      purse-first,
    }:
    let
      system = "x86_64-linux";
      pkgs = igloo.legacyPackages.${system};
      mkGeneratedSrc = import ./generated-src.nix { inherit pkgs; };

      # Generator binaries as buildGoApplication (input-addressed) builds when the
      # package exposes one (buildGoAuto's passthru.bga), else as published. A
      # generated src downstream of a godyn-built (content-addressed) generator is
      # a deferred path at eval time, which godyn's builtins.path-based source
      # handling cannot read (verified: "path '/<hash>' does not exist"; the same chain built with
      # godyn-built generators fails, with these it builds).
      ia = p: p.passthru.bga or p;
      tommyBin = ia tommy.packages.${system}.default;
      dagnabitBin = ia purse-first.packages.${system}.dagnabit;

      # Same fixture, parameterised by which tommy binary generates. The tommy
      # LIBRARY the fixture compiles against is always inputs.tommy's go-pkgs.
      build = tommyGen: buildOrdered tommyGen (x: x);
      buildOrdered =
        tommyGen: order:
        mkGeneratedSrc {
          pname = "gen-fixture";
          src = ./fixture;
          manifest = ./fixture/go.nix;
          inputs = { inherit tommy; };
          subPackages = [ "cmd/app" ];
          stages = order [
            {
              # 1. dagnabit: internal/alfa/greeter -> pkgs/greeter/main.go
              name = "dagnabit";
              command = "dagnabit export";
              nativeBuildInputs = [ dagnabitBin ];
            }
            {
              # 2. tommy: type-loads internal/bravo/cfg, which imports the
              # facade stage 1 produced -> cfg_tommy.go
              name = "tommy";
              command = "go generate -run tommy ./...";
              nativeBuildInputs = [ tommyGen ];
            }
          ];
        };

      main = build tommyBin;

      # Simulated generator bump that moves ONLY the header stamp (what a lock
      # bump of tommy does to every generated file): the same tommy, then the
      # version/commit in the header rewritten. Everything else is byte-equal.
      tommyRestamped = pkgs.writeShellScriptBin "tommy" ''
        ${tommyBin}/bin/tommy "$@" || exit $?
        sed -i 's/^\/\/ Code generated by tommy [^;]*;/\/\/ Code generated by tommy 9.9.9 (0000000);/' ./*_tommy.go
      '';
      restamped = build tommyRestamped;
      # tommy before dagnabit: must FAIL (tommy type-loads cfg, whose facade
      # import does not exist yet). Generator ordering is the author's job.
      wrongOrder = buildOrdered tommyBin pkgs.lib.reverseList;
    in
    {
      # empty shell: just-us wraps recipes in `nix develop` when a flake.nix is present
      devShells.${system}.default = pkgs.mkShell { };
      packages.${system} = {
        inherit tommyBin dagnabitBin;
        # the fully generated source tree (stage outputs are .stageSrcs)
        generated-src = main.generated;
        stage1-src = builtins.elemAt main.stageSrcs 1;
        app = main.module;
        generated-src-wrong-order = wrongOrder.generated;
        generated-src-restamped = restamped.generated;
        app-restamped = restamped.module;
        # the committed fixture holds no generated file; the derivation-space
        # tree holds both, and the built app runs
        test =
          assert !builtins.pathExists (./fixture + "/pkgs");
          assert !builtins.pathExists (./fixture + "/internal/bravo/cfg/cfg_tommy.go");
          pkgs.runCommandLocal "godyn-gen-poc-test" { } ''
          fail() { echo "FAIL: $*" >&2; exit 1; }
          head -1 ${main.generated}/pkgs/greeter/main.go | grep -q 'Code generated by dagnabit' || fail "facade header"
          head -1 ${main.generated}/internal/bravo/cfg/cfg_tommy.go | grep -q 'Code generated by tommy' || fail "tommy header"
          got=$(${main.module}/bin/app)
          [ "$got" = "hello, world!" ] || fail "app printed: $got"
          echo "$got" > $out
        '';
      };
    };
}
