# godyn generators (FDR 0014): code generators (dagnabit facades, tommy
# companions, go generate) run in derivation space instead of being committed.
#
# Each stage is `command` run by the module's codegenCheck machinery — pure,
# offline, in the vendored/rendered module tree — and the stage's codegenPatch is
# applied to the stage's src to give the next stage's src. Stage N therefore
# sees what stages 1..N-1 generated, and the final tree is a plain store tree
# the ordinary builder consumes (its graph is derived from it, so generated
# packages are graph nodes like any other).
#
# buildGodynModule is the plain builder (no `generators`); generators-aware entry
# points are defined here on top of it.
{
  lib,
  runCommandLocal,
  git,
  buildGodynModule,
}:
rec {
  # args: buildGodynModule args (manifest or rendered). generators: [ { name;
  # command; nativeBuildInputs ? [ ]; } ] in run order.
  generate =
    { args, generators }:
    let
      # codegenOnly: a stage never needs the package graph, and the tree it runs
      # on may not be graphable yet (it imports what an earlier stage writes)
      stageModule =
        src:
        buildGodynModule (
          args
          // {
            inherit src;
            codegenOnly = true;
          }
        );
      patchOf =
        src: g:
        ((stageModule src).passthru.codegenCheck {
          inherit (g) command;
          nativeBuildInputs = g.nativeBuildInputs or [ ];
        }).passthru.codegenPatch;
      step =
        acc: g:
        let
          src = lib.last acc.trees;
          patch = patchOf src g;
        in
        {
          patches = acc.patches ++ [ patch ];
          trees = acc.trees ++ [
            (runCommandLocal "${args.pname}-gen-${g.name}" { nativeBuildInputs = [ git ]; } ''
              cp -r --no-preserve=mode ${src} $out
              cd $out
              if [ -s ${patch}/patch ]; then git apply -p2 ${patch}/patch; fi
            '')
          ];
        };
      r = lib.foldl' step {
        patches = [ ];
        trees = [ args.src ];
      } generators;
    in
    {
      generated = lib.last r.trees;
      stages = r.trees;
      inherit (r) patches;
    };

  # Regenerate the raw tree with `generators` and require it to equal `generated`
  # up to the generators' "Code generated by ..." header lines — the version
  # stamp a generator bump moves. For a generator that builds itself (dagnabit's
  # own facades): generate with a pinned SEED generator, then check with the
  # freshly built one; a facade-shape change without a new seed fails here.
  fixedPoint =
    {
      pname,
      args,
      generated,
    }:
    generators:
    let
      again = (generate { inherit args generators; }).generated;
    in
    runCommandLocal "${pname}-generators-fixed-point" { } ''
      mkdir -p $out
      if ! diff -r -I '^// Code generated by ' ${generated} ${again} > $out/diff; then
        cat $out/diff >&2
        echo "godyn generators (${pname}): the regenerated tree differs from the generated tree beyond generator header lines" >&2
        exit 1
      fi
    '';

  # buildGodynModule with `generators`. Without them it is the plain builder.
  # codegenOnly returns just the generation passthru (no module, so a stage's
  # failure surfaces as that stage's build failure, not as an eval-time IFD error).
  build =
    args:
    if (args.generators or [ ]) == [ ] then
      buildGodynModule (removeAttrs args [ "generators" ])
    else
      let
        plain = removeAttrs args [
          "generators"
          "codegenOnly"
        ];
        g = generate {
          args = plain;
          inherit (args) generators;
        };
        genPassthru = {
          generatedSrc = g.generated;
          generatorStages = g.stages;
          generatorPatches = g.patches;
          generatorsFixedPoint = fixedPoint {
            inherit (args) pname;
            args = plain;
            inherit (g) generated;
          };
        };
      in
      if args.codegenOnly or false then
        { passthru = genPassthru; }
      else
        # a manifest module renders its go.mod around `src`; the generated tree
        # carries no go.mod of its own, so the manifest stays on the call
        (buildGodynModule (plain // { src = g.generated; })).overrideAttrs (old: {
          passthru = (old.passthru or { }) // genPassthru;
        });
}
