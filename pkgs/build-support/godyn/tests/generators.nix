# godyn generators (FDR 0014): generated Go lives in derivations, never in the
# tracked tree. Two stub generators stand in for dagnabit (a facade pkgs/hello
# written from internal/hello) and tommy (internal/cfg/cfg_gen.go, which refuses
# to run unless the facade already exists, so stage order is observable).
#
# The stubs are CONTENT-ADDRESSED on purpose, like a godyn-built dagnabit or
# tommy: a source tree downstream of one is a deferred path at eval time, which
# godyn must read without builtins.path (the verified blocker of FDR 0014). The
# raw fixture does not load (cfg imports a facade that does not exist), so the
# package graph of a stage module must never be forced.
{ pkgs }:
let
  inherit (pkgs) lib;
  ca =
    drv:
    drv.overrideAttrs {
      __contentAddressed = true;
      outputHashMode = "recursive";
      outputHashAlgo = "sha256";
    };

  # stamp: the generator's version header, the one thing a generator bump moves
  facadeGen =
    stamp:
    ca (
      pkgs.writeShellScriptBin "stubfacade" ''
        for d in internal/*/; do
          leaf=$(basename "$d")
          if grep -qs 'stubgen-facade' "$d"*.go; then
            mkdir -p "pkgs/$leaf"
            printf '// Code generated by stubfacade (%s); DO NOT EDIT.\n\npackage %s\n\nimport internal "example.com/genstub/internal/%s"\n\nvar Hello = internal.Hello\n' \
              '${stamp}' "$leaf" "$leaf" > "pkgs/$leaf/main.go"
          fi
        done
      ''
    );
  cfgGen =
    stamp:
    ca (
      pkgs.writeShellScriptBin "stubcfg" ''
        [ -f pkgs/hello/main.go ] || { echo "stubcfg: ordering: the facade has not been generated yet" >&2; exit 1; }
        printf '// Code generated by stubcfg (%s); DO NOT EDIT.\n\npackage cfg\n\nconst cfgSuffix = "!"\n' '${stamp}' > internal/cfg/cfg_gen.go
      ''
    );

  stages = stamp: [
    {
      name = "facade";
      command = "stubfacade";
      nativeBuildInputs = [ (facadeGen stamp) ];
    }
    {
      name = "cfg";
      command = "stubcfg";
      nativeBuildInputs = [ (cfgGen stamp) ];
    }
  ];

  fixture = ./generators;
  args = {
    pname = "godyn-generators";
    version = "0.0.0";
    src = fixture;
    manifest = ./generators/go.nix;
    subPackages = [ "." ];
  };

  app = pkgs.buildGodynModule (args // { generators = stages "v1"; });
  # a generator bump that moves only the header stamp
  appBumped = pkgs.buildGodynModule (args // { generators = stages "v2"; });
  # buildGoAuto, godyn backend
  autoApp = pkgs.buildGoAuto (args // { generators = stages "v1"; });
  # wrong order: cfg before the facade; codegenOnly reaches the failing patch
  # without building the module, whose graph would be IFD over a failed stage
  wrongOrder = pkgs.buildGodynModule (
    args
    // {
      generators = lib.reverseList (stages "v1");
      codegenOnly = true;
    }
  );
  stageTree = n: builtins.elemAt app.passthru.generatorStages n;
in
{
  # the chain builds and runs; the tracked fixture holds nothing generated, each
  # stage tree holds exactly what its stage produced; a stamp-only bump of both
  # generators reaches the same binary (content-addressed early cutoff); and the
  # fixed point accepts a stamp-only regeneration.
  godyn-generators-test =
    assert !builtins.pathExists (fixture + "/pkgs");
    assert !builtins.pathExists (fixture + "/internal/cfg/cfg_gen.go");
    assert lib.length app.passthru.generatorStages == 3;
    pkgs.runCommandLocal "godyn-generators-test-check" { } ''
      fail() { echo "FAIL: $*" >&2; exit 1; }
      [ "$(${app}/bin/genstub)" = "hello!" ] || fail "app output"
      [ ! -e ${stageTree 0}/pkgs ] || fail "stage 0 is not the raw tree"
      [ -f ${stageTree 1}/pkgs/hello/main.go ] || fail "stage 1 lacks the facade"
      [ ! -e ${stageTree 1}/internal/cfg/cfg_gen.go ] || fail "stage 1 ran stage 2"
      [ -f ${app.passthru.generatedSrc}/internal/cfg/cfg_gen.go ] || fail "final tree lacks cfg_gen.go"
      grep -q 'stubfacade (v1)' ${app.passthru.generatedSrc}/pkgs/hello/main.go || fail "facade stamp"
      grep -q 'stubfacade (v2)' ${appBumped.passthru.generatedSrc}/pkgs/hello/main.go || fail "bumped stamp"
      [ "${app}" = "${appBumped}" ] || fail "stamp-only bump changed the binary: ${app} vs ${appBumped}"
      [ ! -s ${app.passthru.generatorsFixedPoint (stages "v2")}/diff ] || fail "fixed point reported a difference"
      echo ok > $out
    '';
  # buildGoAuto passes generators through (godyn backend) and keeps the passthru
  godyn-generators-auto-test =
    assert autoApp.passthru.backend == "native";
    pkgs.runCommandLocal "godyn-generators-auto-test-check" { } ''
      [ "$(${autoApp}/bin/genstub)" = "hello!" ] || { echo "FAIL: auto output" >&2; exit 1; }
      [ -f ${autoApp.passthru.generatedSrc}/pkgs/hello/main.go ] || { echo "FAIL: auto generatedSrc" >&2; exit 1; }
      echo ok > $out
    '';
  # the stages run in list order: cfg first fails in its own patch build, naming why
  godyn-generators-order-test = pkgs.testers.testBuildFailure' {
    drv = builtins.head wrongOrder.passthru.generatorPatches;
    expectedBuilderLogEntries = [ "stubcfg: ordering: the facade has not been generated yet" ];
  };
  # a generator that changes the generated code (not just the stamp) is not a
  # fixed point: the check fails, showing the difference
  godyn-generators-fixed-point-fail-test = pkgs.testers.testBuildFailure' {
    drv = app.passthru.generatorsFixedPoint [
      (builtins.head (stages "v1"))
      {
        name = "cfg";
        command = ''
          printf 'package cfg\n\nconst cfgSuffix = "?"\n' > internal/cfg/cfg_gen.go
        '';
      }
    ];
    expectedBuilderLogEntries = [ "cfgSuffix" ];
  };
}
